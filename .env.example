# =============================================================================
# PulpLabs Learn — configuration
#
# Copy to .env and fill in. .env is gitignored; this file is not, so nothing
# real belongs in it.
#
#   docker run --env-file .env -p 3000:3000 pulplabs-learn
# =============================================================================

# --- authentication ----------------------------------------------------------
# Signs session tokens and derives the field-encryption and blind-index keys.
# Generate one with:  openssl rand -base64 48
#
# Leave it unset and the service generates a secret on first boot and keeps it
# in the settings table, which is fine for a demo and wrong for anything real:
# rotating it then means editing a database row, and two instances of the
# service would issue tokens the other rejects.
AUTH_SECRET=

# How long a session lasts, in seconds. Default is 7 days.
# AUTH_TOKEN_TTL=604800

# --- google sign-in ----------------------------------------------------------
# From the OAuth client in Google Cloud Console → Credentials.
# Both are read by the content service; the web app never sees them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered on that client, exactly.
#
# Left unset, the app uses the origin the request arrived on (for example
# http://localhost:3000), because that is what the current client registers.
# A callback that lands on the site root is rewritten to the handler by
# src/middleware.js.
#
# If you register <origin>/api/auth/google/callback instead — the tidier
# arrangement — set it here and the middleware never fires.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- playground --------------------------------------------------------------
# PLAYGROUND_LEASE_MINUTES=45
# PLAYGROUND_RUN_QUOTA=60

# --- plumbing ----------------------------------------------------------------
# Where the web app finds the content service. The container sets this itself.
# CONTENT_API_URL=http://127.0.0.1:4000
# DATABASE_URL=postgres://postgres@127.0.0.1:5432/learn
# POSTGRES_PASSWORD=
